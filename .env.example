# Copy to .env and adjust for your local OpenAI-compatible LLM server
# (llama.cpp server, LM Studio, vLLM, Strata, ...)

# Base URL of the OpenAI-compatible API (must include the /v1 suffix)
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8080/v1

# Bearer token, if the server requires one (leave empty to skip auth)
OPENAI_COMPAT_API_KEY=
